{
  "name": "beam-web",
  "packageManager": "yarn@3.5.0",
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --no-fork",
    "build": "nuxi build",
    "dev-run": "cd dist && python3 -m http.server 3000",
    "generate": "yarn lintfix && NODE_OPTIONS=--max-old-space-size=8192 nuxi generate",
    "preview": "yarn lintfix && nuxi preview",
    "lint:js": "eslint --ext \".ts,.vue\" --ignore-path .gitignore .",
    "lint:prettier": "prettier --check .",
    "lint": "yarn lint:js && yarn lint:prettier",
    "lintfix": "prettier --write --list-different . && yarn lint:js --fix",
    "check-updates": "npx npm-check-updates",
    "apply-updates": "npx npm-check-updates -u && yarn install",
    "update-submodules": "git submodule sync && git submodule update --remote --force"
  },
  "devDependencies": {
    "@nuxt/content": "^3.14.0",
    "@nuxtjs/device": "^3.2.4",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/fontaine": "^0.5.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/robots": "^6.1.2",
    "@nuxtjs/sitemap": "^8.2.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/fs-extra": "^11.0.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^7.18.0",
    "better-sqlite3": "^12.5.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "node-html-parser": "^7.1.0",
    "nuxt": "^3.21.10",
    "nuxt-seo-utils": "^8.3.1",
    "prettier": "^3.9.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/typography": "^0.5.20",
    "@types/canvas-confetti": "^1.9.0",
    "@types/markdown-it": "^13.0.9",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^3.6.0",
    "fs-extra": "^11.3.6",
    "glob": "^10.5.0",
    "gsap": "^3.15.0",
    "markdown-it": "^14.2.0",
    "npm-check-updates": "^16.14.20",
    "nuxt-security": "^1.4.3",
    "swiper": "^14.0.1",
    "tailwindcss": "^3.4.19",
    "vue3-marquee": "^4.2.2"
  },
  "resolutions": {
    "nuxt": "3.21.10",
    "@nuxt/schema": "3.21.8",
    "minimatch@9.0.3": "9.0.9",
    "tar": "7.5.19",
    "esbuild@^0.27.0": "0.28.1",
    "lodash": "4.18.1",
    "cross-spawn": "7.0.6",
    "path-to-regexp@^6.2.1": "6.3.0",
    "micromatch": "4.0.8"
  }
}
